{
  "name": "ecfr-analyzer",
  "version": "1.0.0",
  "description": "eCFR Federal Regulations Analysis Website",
  "private": true,
  "workspaces": [
    "server",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=frontend\"",
    "download": "npm run download --workspace=server",
    "build": "npm run build --workspace=server && npm run build --workspace=frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
